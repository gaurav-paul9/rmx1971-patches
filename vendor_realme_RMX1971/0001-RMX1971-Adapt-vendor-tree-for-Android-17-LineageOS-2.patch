                 "libc",
                 "libm",
@@ -12098,7 +12095,6 @@ cc_prebuilt_library_shared {
                 "proprietary/vendor/lib64/libsdm-disp-vndapis.so",
             ],
             shared_libs: [
-                "libdisplaydebug",
                 "libqservice",
                 "libbinder",
                 "libcutils",
@@ -12128,7 +12124,6 @@ cc_prebuilt_library_shared {
                 "proprietary/vendor/lib64/libsdmextension.so",
             ],
             shared_libs: [
-                "libdisplaydebug",
                 "libsdmutils",
                 "libdisplayqos",
                 "libsdm-color",
@@ -16042,7 +16037,6 @@ cc_prebuilt_library_shared {
                 "libjpeg",
                 "libpiex",
                 "libpng",
-                "libheif",
                 "libnativewindow",
                 "libEGL",
                 "libGLESv2",
@@ -16074,7 +16068,6 @@ cc_prebuilt_library_shared {
                 "libjpeg",
                 "libpiex",
                 "libpng",
-                "libheif",
                 "libnativewindow",
                 "libEGL",
                 "libGLESv2",
@@ -16809,7 +16802,7 @@ cc_prebuilt_library_shared {
                 "libaudioclient",
                 "libaudiofoundation",
                 "audioclient-types-aidl-cpp",
-                "android.media.audio.common.types-V4-cpp",
+                "android.media.audio.common.types-V5-cpp",
                 "libwfdmmsrc_system",
                 "libwfdavenhancements",
                 "libhidlbase",
