Date: Sun, 11 Oct 2026 06:36:39 +0000
Subject: [PATCH] RMX1971: Adapt vendor tree for Android 17 (LineageOS 24.0)

- Switch soong_namespace import to hardware/qcom-caf/sdm660
- Remove deprecated libdisplaydebug and libheif references
- Bump libwfdservice audio common types dependency to V5 and patch DT_NEEDED
---
 Android.bp                                  |  11 ++---------
 proprietary/system_ext/lib/libwfdservice.so | Bin 264389 -> 296353 bytes
 2 files changed, 2 insertions(+), 9 deletions(-)

diff --git a/Android.bp b/Android.bp
index 2c55851..3a2d6d2 100644
--- a/Android.bp
+++ b/Android.bp
@@ -5,7 +5,7 @@
 soong_namespace {
     imports: [
         "device/realme/RMX1971",
-        "hardware/qcom-caf/sdm845",
+        "hardware/qcom-caf/sdm660",
         "hardware/qcom-caf/wlan",
         "vendor/qcom/opensource/commonsys-intf/display",
         "vendor/qcom/opensource/commonsys/display",
@@ -12015,7 +12015,6 @@ cc_prebuilt_library_shared {
             shared_libs: [
                 "libdrm",
                 "libdrmutils",
-                "libdisplaydebug",
                 "libc++",
                 "libc",
                 "libm",
@@ -12044,7 +12043,6 @@ cc_prebuilt_library_shared {
                 "libcutils",
                 "libbinder",
                 "libutils",
-                "libdisplaydebug",
                 "libtinyxml2_1",
                 "libc++",
                 "libc",
@@ -12073,7 +12071,6 @@ cc_prebuilt_library_shared {
                 "libdiag",
                 "libsdmutils",
